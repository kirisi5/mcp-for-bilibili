# ============================================
# B站 综合认知 MCP Server — 环境变量
# ============================================

# --- B站 认证 ---
BILI_SESSDATA=XXX
BILI_BILI_JCT=XXX
BILI_BUVID3=XXX

# --- Redis（可选，用于多级缓存）---
# Docker Compose 部署时使用：redis://redis:6379/0
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0

# --- 缓存策略 ---
CACHE_TTL_SHORT=300       # 实时数据 5 分钟
CACHE_TTL_MEDIUM=1800     # 半实时 30 分钟
CACHE_TTL_LONG=86400      # 静态数据 24 小时

# --- HTTP客户端 ---
HTTP_TIMEOUT=30.0
HTTP_MAX_RETRIES=3
HTTP_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# --- 限流 ---
RATE_LIMIT_VIDEO=5        # 每秒视频请求数
RATE_LIMIT_SEARCH=3       # 每秒搜索请求数
RATE_LIMIT_COMMENT=2      # 每秒评论请求数

# --- 日志 ---
LOG_LEVEL=INFO
LOG_FORMAT=json           # json | text

# --- MCP Server ---
MCP_SERVER_NAME=B站综合认知
MCP_SERVER_PORT=8000
